---
import PersonProfile from '@/components/PersonProfile.astro'
import { getGuests, type Guest } from '@/lib/content'
export async function getStaticPaths() {
  return (await getGuests()).map((person) => ({
    params: { id: person.id },
    props: { person },
  }))
}
interface Props {
  person: Guest
}
const { person } = Astro.props
---

<PersonProfile person={person} kind="guest" />
