---
import { render } from 'astro:content'
import { Icon } from '@prosefly/astro-components'
import BaseLayout from '@/layouts/BaseLayout.astro'
import PersonAvatar from '@/components/PersonAvatar.astro'
import PersonCard from '@/components/PersonCard.astro'
import {
  getPosts,
  getEpisodes,
  formatDate,
  readingTime,
  personProfileUrl,
  type BlogPost,
} from '@/lib/content'
export async function getStaticPaths() {
  return (await getPosts()).map((post) => ({
    params: { id: post.id },
    props: { post },
  }))
}
interface Props {
  post: BlogPost
}
const { post } = Astro.props
const { Content } = await render(post)
const episode = post.data.episode
  ? (await getEpisodes()).find((entry) => entry.id === post.data.episode?.id)
  : undefined
---

<BaseLayout
  title={`${post.data.title} — Iris journal`}
  description={post.data.description}
  type="article"
  authors={post.authors.map((author) => author.data.name)}
>
  <article class="article wrap">
    <a class="text-link back-link" href="/blog/">
      <Icon name="lucide:arrow-left" size={16} /> The journal
    </a>
    <header class="article-header">
      <span class="eyebrow">{post.data.category}</span>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="article-byline">
        {post.authors.map((author) => (
          <a class="person-chip" href={personProfileUrl(author)}>
            <PersonAvatar person={author} size={26} />
            <span>{author.data.name}</span>
          </a>
        ))}
        <span>·</span>
        <time datetime={post.data.publishedAt.toISOString()}>
          {formatDate(post.data.publishedAt)}
        </time>
        <span>·</span>
        {readingTime(post.body)}
      </div>
    </header>
    <div class="prose">
      <Content />
      {episode && (
        <aside class="related-episode">
          <span class="eyebrow">A conversation to go with this</span>
          <h2>
            <a href={`/episodes/${episode.id}/`}>{episode.data.title}</a>
          </h2>
          <a class="text-link" href={`/episodes/${episode.id}/`}>
            Listen to the episode{' '}
            <Icon name="lucide:arrow-up-right" size={17} />
          </a>
        </aside>
      )}
    </div>
    <section class="article-authors" aria-labelledby="authors-heading">
      <h2 id="authors-heading">
        About the {post.authors.length === 1 ? 'author' : 'authors'}.
      </h2>
      <div class="person-grid">
        {post.authors.map((author) => (
          <PersonCard person={author} kind="author" />
        ))}
      </div>
    </section>
  </article>
</BaseLayout>
