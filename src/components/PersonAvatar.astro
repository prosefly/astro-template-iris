---
import type { Person } from '@/lib/content'
interface Props {
  person: Person
  size?: number
}
const { person, size = 40 } = Astro.props
const initials = person.data.name
  .trim()
  .split(/\s+/)
  .map((part) => part[0])
  .slice(0, 2)
  .join('')
---

<span
  class="person-avatar"
  style={`--avatar-size: ${size}px`}
  aria-hidden="true"
>
  {person.data.avatar ? (
    <img
      src={person.data.avatar}
      alt=""
      width={size}
      height={size}
      loading="lazy"
    />
  ) : (
    initials
  )}
</span>
<style>
  .person-avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--avatar-size);
    height: var(--avatar-size);
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--color-line);
    border-radius: 50%;
    background: var(--color-inset);
    color: var(--color-ink);
    font-family: var(--font-serif);
    font-size: calc(var(--avatar-size) * 0.43);
    line-height: var(--line-height-tight);
  }
  .person-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
