---
interface Props {
  compact?: boolean
}
const { compact = false } = Astro.props
---

<a class:list={['brand', { compact }]} href="/" aria-label="Iris home">
  <svg width="32" height="32" viewBox="0 0 32 32" aria-hidden="true">
    <g fill="currentColor">
      <ellipse cx="16" cy="10" rx="4" ry="9" />
      <ellipse cx="16" cy="22" rx="4" ry="9" />
      <ellipse cx="10" cy="16" rx="9" ry="4" />
      <ellipse cx="22" cy="16" rx="9" ry="4" />
      <ellipse cx="16" cy="16" rx="4" ry="14" transform="rotate(45 16 16)" />
      <ellipse cx="16" cy="16" rx="4" ry="14" transform="rotate(-45 16 16)" />
    </g>
    <circle cx="16" cy="16" r="3" fill="var(--color-canvas)" />
  </svg>
  <span>
    iris<span class="brand-dot">.</span>
  </span>
</a>
